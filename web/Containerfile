# The administration UI image, built from the repository root because the app
# compiles against the contract in ../contract through the $contract and
# $contractClient aliases — those files are outside web/ and there is no npm
# package to install them from.
#
#   docker build -f web/Containerfile --build-arg VERSION=<tag> .
#
# Three stages for two runtimes: the build runs under Node with the committed
# package-lock.json, so the image gets exactly the dependency set the gate ran
# against; a second Node stage resolves the runtime dependency closure from that
# same lockfile; and the result is served by Bun, which is what
# svelte-adapter-bun emits a server for.
FROM docker.io/library/node:22-alpine AS build
WORKDIR /src

# The contract's TypeScript imports @connectrpc/connect and @bufbuild/protobuf.
# It resolves them from this app's node_modules through the symlink below —
# the same arrangement vite.config.ts's `dedupe` describes for local builds.
COPY contract/gen/ts/ /contract/gen/ts/
COPY contract/ts/ /contract/ts/

COPY web/package.json web/package-lock.json ./
RUN npm ci
RUN ln -s /src/node_modules /contract/node_modules

# Copied by name rather than by whole directory: it keeps node_modules, build
# output, and the test suites out of the image without depending on which
# .dockerignore a builder decides to read for a -f build.
COPY web/src ./src
COPY web/static ./static
COPY web/messages ./messages
COPY web/project.inlang ./project.inlang
COPY web/svelte.config.js web/vite.config.ts web/tsconfig.json web/components.json ./

# The version the UI reports and compares against control's /health. BASE_PATH
# serves the app under a prefix; the deployment serves it at the domain root and
# leaves it empty.
ARG VERSION=dev
ARG BASE_PATH=
ENV APP_VERSION=${VERSION}
ENV BASE_PATH=${BASE_PATH}
RUN npm run build

# The generated server does NOT bundle its imports: its chunks still import
# svelte, @sveltejs/kit, @bufbuild/protobuf, zod and the rest by name, and they
# are resolved when a request first loads a route chunk. Without them next to
# the server, every route answers 500 while the process itself starts and looks
# healthy — and Bun, finding no node_modules at all, would try to fetch the
# missing packages from the registry at run time. npm computes that closure here
# from the same lockfile, so it is exactly package.json's runtime dependencies
# and their transitive set, with no build tooling.
FROM docker.io/library/node:22-alpine AS deps
WORKDIR /runtime
COPY web/package.json web/package-lock.json ./
RUN npm ci --omit=dev

FROM docker.io/oven/bun:1.3.14-alpine
# Nothing in the served output is written at runtime, and the process needs no
# privilege: it answers HTTP on the internal bridge and reaches nothing else.
COPY --from=deps --chown=bun:bun /runtime/node_modules /app/node_modules
COPY --from=build --chown=bun:bun /src/build /app
USER bun
WORKDIR /app
EXPOSE 3000
ENV PORT=3000
CMD ["bun", "run", "/app/index.js"]
