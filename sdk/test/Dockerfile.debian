

















ARG DEBIAN_SUITE=bookworm
FROM golang:1.26-${DEBIAN_SUITE} AS base










RUN apt-get update && apt-get install -y --no-install-recommends \
    psmisc \
    ca-certificates \
    cryptsetup-bin \
    nftables \
    iproute2 \
    gnupg \
    smartmontools \
    openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace



COPY sdk/ ./sdk/
RUN cd sdk && go mod download






FROM base AS state-locked-apt
RUN touch /var/lib/dpkg/lock \
          /var/lib/dpkg/lock-frontend \
          /var/lib/apt/lists/lock \
          /var/cache/apt/archives/lock \
    && test -f /var/lib/dpkg/lock \
       || (echo "PRECONDITION FAILED: /var/lib/dpkg/lock not created" && exit 1)
































FROM base AS with-clamav
RUN apt-get update && apt-get install -y --no-install-recommends clamav \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/clamav \
    && printf '44d88612fea8a8f36de82e1278abb02f:68:Cadestro.Eicar.Test\n' \
       > /var/lib/clamav/cadestro-seed.hdb \
    && printf 'Cadestro.Marker.Test:0:*:434144455354524f2d434c414d41562d544553542d4d41524b4552\n' \
       > /var/lib/clamav/cadestro-seed.ndb \
    && rm -f /etc/clamav/freshclam.conf \
    && clamscan --version \
       || (echo "PRECONDITION FAILED: clamscan not installed/runnable" && exit 1)

FROM base AS with-osquery






ARG OSQUERY_VERSION=5.23.0
ARG OSQUERY_SHA256=8938e83d71c6e668f24648b4fb612581db30f95cd31bf76a86c3ba4a6680a7dc
RUN arch="$(dpkg --print-architecture)" \
    && if [ "$arch" != "amd64" ]; then \
         echo "with-osquery only pins an amd64 .deb; build arch is $arch" && exit 1; \
       fi \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && curl -fsSL --max-time 300 -o /tmp/osquery.deb \
       "https://github.com/osquery/osquery/releases/download/${OSQUERY_VERSION}/osquery_${OSQUERY_VERSION}-1.linux_amd64.deb" \
    && echo "${OSQUERY_SHA256}  /tmp/osquery.deb" | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/osquery.deb \
    && rm -f /tmp/osquery.deb \
    && rm -rf /var/lib/apt/lists/* \
    && osqueryi --version \
       || (echo "PRECONDITION FAILED: osqueryi not installed/runnable" && exit 1)
