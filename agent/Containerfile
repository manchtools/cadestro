
FROM docker.io/library/golang:1.25-bookworm AS builder

WORKDIR /build

COPY sdk/ ./sdk/

COPY agent/go.mod agent/go.sum ./agent/
WORKDIR /build/agent
RUN go mod download

COPY agent/ ./

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /cadestrod ./cmd/cadestrod

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    systemd \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/lib/cadestro && chmod 700 /var/lib/cadestro

COPY --from=builder /cadestrod /usr/local/bin/cadestrod

ENTRYPOINT ["/usr/local/bin/cadestrod"]
