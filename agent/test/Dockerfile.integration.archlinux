
FROM golang:1.26-bookworm AS go-builder
WORKDIR /workspace

COPY contract/ ./contract/
COPY sdk/ ./sdk/
COPY agent/ ./agent/

RUN printf 'go %s\n\nuse (\n\t./contract\n\t./sdk\n\t./agent\n)\n' "$(sed -n 's/^go //p' agent/go.mod)" > go.work
RUN cd agent && go mod download

FROM archlinux:latest

COPY --from=go-builder /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV GOMODCACHE="/go/pkg/mod"

RUN pacman-key --init && pacman-key --populate archlinux

RUN pacman -Syu --noconfirm \
    sudo \
    gnupg \
    openssh \
    && pacman -Scc --noconfirm

RUN mkdir -p /etc/ssh/sshd_config.d && ssh-keygen -A

RUN grep -q 'Include /etc/ssh/sshd_config.d' /etc/ssh/sshd_config || \
    echo 'Include /etc/ssh/sshd_config.d/*.conf' >> /etc/ssh/sshd_config

RUN mkdir -p /var/lib/cadestro/lps

RUN mkdir -p /run/sshd

WORKDIR /workspace

COPY --from=go-builder /workspace ./
COPY --from=go-builder /go/pkg/mod /go/pkg/mod
