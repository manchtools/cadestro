FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y \
    sudo \
    gpg \
    openssh-server \
    systemd \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/ssh/sshd_config.d && ssh-keygen -A

RUN grep -q 'Include /etc/ssh/sshd_config.d' /etc/ssh/sshd_config || \
    echo 'Include /etc/ssh/sshd_config.d/*.conf' >> /etc/ssh/sshd_config

RUN mkdir -p /var/lib/cadestro/lps

RUN mkdir -p /run/sshd

WORKDIR /workspace

COPY contract/ ./contract/
COPY sdk/ ./sdk/
COPY agent/ ./agent/

RUN printf 'go %s\n\nuse (\n\t./contract\n\t./sdk\n\t./agent\n)\n' "$(sed -n 's/^go //p' agent/go.mod)" > go.work

RUN cd agent && go mod download
RUN go install gotest.tools/gotestsum@latest
